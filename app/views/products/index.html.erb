<h1>Game-Move Online Store</h1>

<p>Welcome to our video game store.</p>

<%= render "search_form" %>

<div class="product-summary">
  <strong>Total Products:</strong>
  <%= @product_count %>
</div>

<% if @products.any? %>
  <div class="products">
    <%= render @products %>
  </div>

  <%= paginate @products,
              params: {
                keyword: params[:keyword],
                category_id: params[:category_id],
                filter: params[:filter]
              } %>
  <% else %>
  <p>No products are available.</p>
<% end %>