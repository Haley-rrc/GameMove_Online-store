<h1>Website Pages</h1>

<table>
  <thead>
    <tr>
      <th>Page</th>
      <th>Title</th>
      <th>Last Updated</th>
      <th>Action</th>
    </tr>
  </thead>

  <tbody>
    <% @site_pages.each do |page| %>
      <tr>
        <td><%= page.page_key.capitalize %></td>
        <td><%= page.title %></td>
        <td><%= page.updated_at.strftime("%Y-%m-%d %H:%M") %></td>

        <td>
          <%= link_to "Edit",
                      edit_admin_site_page_path(page) %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>